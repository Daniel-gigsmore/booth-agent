{
  "name": "booth-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Local Windows agent that owns the photobooth camera and printer and exposes them to the kiosk UI over localhost.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "service:install": "node dist/service/install.js",
    "service:uninstall": "node dist/service/uninstall.js",
    "db:migrate": "node dist/scripts/applyMigration.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "chokidar": "^4.0.3",
    "express": "^4.19.2",
    "koffi": "^3.3.1",
    "node-windows": "^1.0.0-beta.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "jsqr": "^1.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
