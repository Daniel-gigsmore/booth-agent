# Copy to .env and fill in. Values are baked in at build time.
VITE_AGENT_URL=http://127.0.0.1:7070
# Must match agent.sharedSecret in booth-agent's booth.config.json.
VITE_AGENT_TOKEN=
# Layout and countdown timing are set in the operator panel (Settings), not here.
VITE_EVENT_NAME=
VITE_EVENT_DATE=
# Guest download page (see download/README.md). {captureId} is replaced per photo. Leave empty to hide the QR code.
# e.g. https://<site>/?event=gigsmore-launch-2026&name=Gigsmore%20Launch&id={captureId}
VITE_DOWNLOAD_URL=
