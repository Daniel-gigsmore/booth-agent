# Copy to .env and fill in. Values are baked in at build time.
VITE_AGENT_URL=http://127.0.0.1:7070
# Must match agent.sharedSecret in booth-agent's booth.config.json.
VITE_AGENT_TOKEN=
# Layout and countdown timing are set in the operator panel (Settings), not here.
# The event name and date come from booth-agent's active event (Operator > Events), not from this file.
# Guest download page (see download/README.md). {captureId}, {eventId} and {eventName} are filled in from the photo and
# the active event (booth-agent). Leave empty to hide the QR code.
# e.g. https://<site>/?event={eventId}&name={eventName}&id={captureId}
VITE_DOWNLOAD_URL=
